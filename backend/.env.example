# Runtime mode
BACKEND_MODE=supabase

# Backend HTTP settings
PORT=3000
CORS_ALLOWED_ORIGINS=*
CACHE_TTL_MS=30000
MAX_CACHE_ENTRIES=500

# Supabase mode
# Optional when SUPABASE_URL is set. If omitted, defaults to:
# ${SUPABASE_URL}/functions/v1/api
EDGE_API_BASE_URL=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Required only in the future ignored SANDBOX environment file. Never invent this value.
SANDBOX_SUPABASE_PROJECT_REF=
SANDBOX_DATABASE_URL=
# Required if a user can belong to more than one org
DEFAULT_ORG_ID=
API_BUILD_SHA=
API_BUILT_AT=

# Verification / smoke scripts
SMOKE_AUTH_TOKEN=
# Preferred local fallback for auth-backed smoke scripts. The scripts mint a fresh
# access token automatically when SMOKE_AUTH_TOKEN is blank.
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
# The smoke provisioner defaults to an admin-capable smoke user so write checks
# like transfer smoke can run. Supported values: member, admin
SMOKE_USER_ROLE=admin
# Enable write-path smoke checks in scripts/smoke-backend-routes.mjs
SMOKE_INCLUDE_MUTATIONS=false
# Optional transfer round-trip smoke configuration
SMOKE_TRANSFER_BOX_ID=
SMOKE_TRANSFER_DEST_WAREHOUSE=
SMOKE_TRANSFER_ROUNDTRIP=false
