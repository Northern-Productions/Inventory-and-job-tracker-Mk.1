{
  "name": "inventory-backend-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.16.3"
  },
  "scripts": {
    "catalog:fasara:apply": "node scripts/apply-fasara-catalog-curation.mjs --apply",
    "catalog:fasara:dry": "node scripts/apply-fasara-catalog-curation.mjs",
    "check:schema:0006": "node scripts/check-schema-0006.mjs",
