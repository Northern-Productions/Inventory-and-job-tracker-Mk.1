# Hosted frontend
VITE_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
VITE_PROXY_TARGET=
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Use these same four names in separate ignored target-specific files:
#   .env.dev.local       -> DEV only
#   .env.sandbox.local   -> SANDBOX only (after the project exists)
#   .env.production.local -> PROD release tooling only
# A SANDBOX local session must never use the production Vercel alias.

# For local rollback/parity backend dev, override with:
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=http://localhost:3000
